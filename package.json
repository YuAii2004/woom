{
  "name": "woom",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite -c vueapp/vite.config.ts",
    "dev:vue": "vite -c vueapp/vite.config.ts",
    "dev-refresh": "cross-env USE_REFRESH=true npm run dev",
    "lint": "eslint && npm run lint:vue",
    "test:unit": "vitest run --exclude tests/e2e/** --exclude tests/e2e-vue/**",
    "test:e2e": "playwright test",
    "test:e2e:vue": "playwright test -c vue-playwright.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "build": "npm run lint:vue && vite build -c vueapp/vite.config.ts",
    "build:vue": "npm run build",
    "lint:vue": "vue-tsc --noEmit -p tsconfig.vue.json",
    "build-refresh": "npm run lint && cross-env USE_REFRESH=true npm run build",
    "preview": "vite preview -c vueapp/vite.config.ts"
  },
  "dependencies": {
    "whip-whep": "1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@stylistic/eslint-plugin-js": "^2.10.1",
    "@types/node": "^22.9.0",
    "cross-env": "^7.0.3",
    "autoprefixer": "^10.4.21",
    "daisyui": "^4.12.24",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
